# Local lakehouse defaults for `make spark-up`.
# Copy to lakehouse/.env to override; the Makefile uses lakehouse/.env when present.

MINIO_IMAGE=RELEASE.2024-11-07T00-52-20Z
MINIO_MC_IMAGE=RELEASE.2024-11-21T17-21-54Z

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host port mapped to Spark Thrift (container listens on 10000). Set DBT_SPARK_PORT to match.
SPARK_THRIFT_PORT=10000
SPARK_UI_PORT=4040

SPARK_VERSION=3.5.4
ICEBERG_VERSION=1.6.1
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262
