# Local lakehouse defaults for `make spark-up`.
# Copy to lakehouse/.env to override; the Makefile uses lakehouse/.env when present.

MINIO_IMAGE=RELEASE.2024-11-07T00-52-20Z
MINIO_MC_IMAGE=RELEASE.2024-11-21T17-21-54Z

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse
LAKEHOUSE_CATALOG=hadoop

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host port mapped to Spark Thrift (container listens on 10000). Set DBT_SPARK_PORT to match.
SPARK_THRIFT_PORT=10000
SPARK_UI_PORT=4040

# Optional overrides for local fixture prep against MinIO (defaults shown).
# AWS_ENDPOINT_URL=http://localhost:9000
# LAKEHOUSE_BUCKET=lakehouse
# LAKEHOUSE_BRONZE_BASE_URI=s3a://lakehouse/lake/parquet/bronze

SPARK_VERSION=3.5.4
ICEBERG_VERSION=1.6.1
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262

# ---------------------------------------------------------------------------
# AWS Glue catalog mode (`make spark-up-aws`)
# Copy these into lakehouse/.env (gitignored) with real dev credentials.
# Do not commit secrets.
# ---------------------------------------------------------------------------
# LAKEHOUSE_CATALOG=glue
# AWS_REGION=us-west-2
# AWS_DEFAULT_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# AWS_S3_BUCKET=sf-urban-health
# LAKEHOUSE_WAREHOUSE_URI=s3://sf-urban-health/warehouse
# LAKEHOUSE_BRONZE_BASE_URI=s3a://sf-urban-health/lake/parquet/bronze
# DBT_SPARK_SCHEMA=sf_urban_health
