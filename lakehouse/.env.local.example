# Local MinIO + Hadoop Iceberg catalog for `make spark-up`.
# Copy to lakehouse/.env.local (gitignored). Never commit secrets.

MINIO_IMAGE=RELEASE.2024-11-07T00-52-20Z
MINIO_MC_IMAGE=RELEASE.2024-11-21T17-21-54Z

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse
LAKEHOUSE_CATALOG=hadoop

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPARK_THRIFT_PORT=10000
SPARK_UI_PORT=4040

# Optional overrides for local fixture prep against MinIO (defaults shown).
# AWS_ENDPOINT_URL=http://localhost:9000
# LAKEHOUSE_BRONZE_BASE_URI=s3a://lakehouse/lake/parquet/bronze
# LAKEHOUSE_METADATA_BASE_URI=s3a://lakehouse/lake/parquet/metadata

SPARK_VERSION=3.5.4
ICEBERG_VERSION=1.6.1
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262

DBT_SPARK_HOST=localhost
DBT_SPARK_PORT=10000
DBT_SPARK_SCHEMA=sf_urban_health
DBT_SPARK_USER=spark
