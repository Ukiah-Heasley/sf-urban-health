# AWS Glue Iceberg catalog for `make spark-up-aws`.
# Copy to lakehouse/.env.aws (gitignored). Never commit secrets.

LAKEHOUSE_CATALOG=glue
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_S3_BUCKET=sf-urban-health
LAKEHOUSE_WAREHOUSE_URI=s3://sf-urban-health/warehouse
LAKEHOUSE_BRONZE_BASE_URI=s3a://sf-urban-health/lake/parquet/bronze
LAKEHOUSE_METADATA_BASE_URI=s3a://sf-urban-health/lake/parquet/metadata

SPARK_THRIFT_PORT=10000
SPARK_UI_PORT=4040

SPARK_VERSION=3.5.4
ICEBERG_VERSION=1.6.1
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262

DBT_SPARK_HOST=localhost
DBT_SPARK_PORT=10000
DBT_SPARK_SCHEMA=sf_urban_health
DBT_SPARK_USER=spark
