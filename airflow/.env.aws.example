# AWS S3 raw lake + Glue lakehouse proof. Copy to airflow/.env.aws (gitignored).
# `make airflow-up-aws` copies this file to airflow/.env for Astro.
# Never commit airflow/.env.aws or real credentials.

# === AWS / S3 raw lake ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
AWS_S3_BUCKET=sf-urban-health
# Optional host-side CLI endpoint override for an S3-compatible service.
# LAKEHOUSE_CLI_AWS_ENDPOINT_URL=

# Lakehouse interval planner for promote_raw_to_bronze (defaults shown).
# LAKEHOUSE_PLAN_MODE=pending
# LAKEHOUSE_PLAN_MAX_INTERVALS=50
# LAKEHOUSE_PLAN_START=2018-01-01T00:00:00Z
# LAKEHOUSE_PLAN_END=2026-06-29T00:00:00Z
# LAKEHOUSE_PLAN_LIMIT is retired; setting it makes promotion fail loudly.

# === Airflow REST API for host-side lakehouse CLI ===
# Set real credentials for a non-local Airflow endpoint; admin/admin is local-only.
# AIRFLOW_API_BASE_URL=http://localhost:8080
# AIRFLOW_API_USER=admin
# AIRFLOW_API_PASSWORD=admin

# === DataSF SODA API ===
DATASF_APP_TOKEN=

# === dbt/Spark from Astro Airflow containers (after `make spark-up-aws`) ===
DBT_SPARK_HOST=host.docker.internal
DBT_SPARK_PORT=10000
DBT_SPARK_SCHEMA=sf_urban_health
DBT_SPARK_USER=spark

# AWS Glue lakehouse catalog (host CLI and mirrored into containers when set).
LAKEHOUSE_CATALOG=glue
LAKEHOUSE_WAREHOUSE_URI=s3://sf-urban-health/warehouse
LAKEHOUSE_BRONZE_BASE_URI=s3a://sf-urban-health/lake/parquet/bronze
LAKEHOUSE_METADATA_BASE_URI=s3a://sf-urban-health/lake/parquet/metadata

# === Dashboard ===
# DASHBOARD_MAX_ROWS=200000
# DASH_DEBUG=
