# Local MinIO / lakehouse smoke. Copy to airflow/.env.local (gitignored).
# `make airflow-up-local` copies this file to airflow/.env for Astro.
# Never commit airflow/.env.local.

# === Local MinIO raw lake ===
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-west-2
AWS_S3_BUCKET=lakehouse
# Astro containers reach host-published MinIO (see lakehouse/.env.local MINIO_API_PORT).
AWS_ENDPOINT_URL=http://host.docker.internal:9000
# Host-side lakehouse CLI commands use this endpoint instead of the container-only
# hostname above.
LAKEHOUSE_CLI_AWS_ENDPOINT_URL=http://localhost:9000

# Optional local filesystem root for lakehouse smoke tests without S3.
# LAKE_LOCAL_ROOT=/tmp/sf-urban-health-lake

# Lakehouse interval planner for promote_raw_to_bronze (defaults shown).
# LAKEHOUSE_PLAN_MODE=pending
# LAKEHOUSE_PLAN_MAX_INTERVALS=50
# LAKEHOUSE_PLAN_START=2024-03-15T06:00:00+00:00
# LAKEHOUSE_PLAN_END=2024-03-16T06:00:00+00:00
# LAKEHOUSE_PLAN_LIMIT is retired; setting it makes promotion fail loudly.

# === Airflow REST API for host-side lakehouse CLI ===
# Local Astro defaults are http://localhost:8080 with admin/admin credentials.
# AIRFLOW_API_BASE_URL=http://localhost:8080
# AIRFLOW_API_USER=admin
# AIRFLOW_API_PASSWORD=admin

# === DataSF SODA API ===
DATASF_APP_TOKEN=

# === Local dbt/Spark from Astro Airflow containers ===
# Spark Thrift runs on the host via `make spark-up`; containers use host.docker.internal.
DBT_SPARK_HOST=host.docker.internal
DBT_SPARK_PORT=10000
DBT_SPARK_SCHEMA=sf_urban_health
DBT_SPARK_USER=spark
# dbt metadata read adapters default to s3a://lakehouse/lake/parquet/metadata.
# LAKEHOUSE_METADATA_BASE_URI=s3a://lakehouse/lake/parquet/metadata

# === Dashboard ===
# DASHBOARD_MAX_ROWS=200000
# DASH_DEBUG=
