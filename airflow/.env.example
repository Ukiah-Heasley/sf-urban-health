# ----------------------------------------------------------------------------
# Copy to airflow/.env (gitignored) and fill in. Loaded by:
#   - Astro CLI (airflow-up) into all containers
#   - Makefile (`include $(ENV_FILE)`) for ad-hoc CLI runs
# Never commit airflow/.env.
# ----------------------------------------------------------------------------

# === AWS / S3 raw lake ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_S3_BUCKET=sf-urban-health

# Optional S3-compatible endpoint for local MinIO (see docs/DEVELOPMENT.md).
# Host CLI (make ingest):     AWS_ENDPOINT_URL=http://localhost:9000
# Astro Airflow containers:   AWS_ENDPOINT_URL=http://host.docker.internal:9000
# AWS_S3_ENDPOINT_URL=        # alternate name; AWS_ENDPOINT_URL wins when both are set

# Local MinIO smoke example (after `make spark-up`; bucket created by minio-init):
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_BUCKET=lakehouse
# AWS_ENDPOINT_URL=http://host.docker.internal:9000

# Optional local filesystem root for lakehouse smoke tests without AWS.
# LAKE_LOCAL_ROOT=/tmp/sf-urban-health-lake

# Lakehouse interval planner for promote_raw_to_bronze (defaults shown).
# LAKEHOUSE_PLAN_MODE=pending
# LAKEHOUSE_PLAN_LIMIT=1
# LAKEHOUSE_PLAN_START=2024-03-15T06:00:00+00:00
# LAKEHOUSE_PLAN_END=2024-03-16T06:00:00+00:00

# === DataSF SODA API ===
# App token is free; sent as the preferred X-App-Token header.
DATASF_APP_TOKEN=

# === Local dbt/Spark from Astro Airflow containers ===
# Spark Thrift runs on the host via `make spark-up` (MinIO) or `make spark-up-aws`
# (AWS Glue); containers reach it through host.docker.internal. Host CLI dbt
# targets use localhost instead.
# DBT_SPARK_HOST=host.docker.internal
# DBT_SPARK_PORT=10000
# DBT_SPARK_SCHEMA=sf_urban_health
# DBT_SPARK_USER=spark

# AWS Glue lakehouse proof from host CLI (after `make spark-up-aws`):
# LAKEHOUSE_CATALOG=glue
# LAKEHOUSE_WAREHOUSE_URI=s3://sf-urban-health/warehouse
# LAKEHOUSE_BRONZE_BASE_URI=s3a://sf-urban-health/lake/parquet/bronze

# === Dashboard ===
# Startup safety guard: refuses to load if a mart returns more than this.
# DASHBOARD_MAX_ROWS=200000
# Set to 1 to enable Dash dev-tools / interactive traceback (off by default).
# DASH_DEBUG=
