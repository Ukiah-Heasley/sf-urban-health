# Mode-specific templates (copy the one you need; never commit private env files):
#
#   cp airflow/.env.local.example airflow/.env.local   # MinIO local smoke
#   cp airflow/.env.aws.example airflow/.env.aws       # AWS S3 + Glue proof
#
# Astro reads airflow/.env (gitignored). Make targets copy the selected mode file:
#   make airflow-up-local   # airflow/.env.local -> airflow/.env
#   make airflow-up-aws     # airflow/.env.aws -> airflow/.env
#
# Ad-hoc Airflow CLI targets source airflow/.env when they run.
