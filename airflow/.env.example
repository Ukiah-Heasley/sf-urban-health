SNOWFLAKE_ACCOUNT=xxxxx-xxxxx
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_DATABASE=SF_URBAN_HEALTH
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_S3_BUCKET=sf-urban-health

DATASF_APP_TOKEN=
DATASF_SECRET_TOKEN=

# dbt: 'dev' (per-developer sandbox) or 'prod' (bare schemas, used by the DAG)
DBT_TARGET=dev
DBT_DEV_SCHEMA=dbt_yourname

# Dashboard: which Snowflake schema holds the dbt marts. Default 'MARTS'
# (set by the generate_schema_name macro). Override to point at a sandbox.
# DASHBOARD_MART_SCHEMA=MARTS
