# ----------------------------------------------------------------------------
# Copy to airflow/.env (gitignored) and fill in. Loaded by:
#   - Astro CLI (airflow-up) into all containers
#   - Makefile (`include $(ENV_FILE)`) for ad-hoc CLI runs
#   - dbt via env_var() in dbt/profiles.yml
# Never commit airflow/.env.
# ----------------------------------------------------------------------------

# === Snowflake ===
SNOWFLAKE_ACCOUNT=xxxxx-xxxxx
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_DATABASE=SF_URBAN_HEALTH
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Default Snowflake schema for the dashboard (overridden per-mart below).
SNOWFLAKE_SCHEMA=prod

# === AWS / S3 raw lake ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_S3_BUCKET=sf-urban-health

# === DataSF SODA API ===
# App token is free; sent as the preferred X-App-Token header.
DATASF_APP_TOKEN=

# === dbt ===
# 'dev' (per-developer sandbox) or 'prod' (bare schemas, used by the DAG).
DBT_TARGET=dev
DBT_DEV_SCHEMA=dbt_yourname

# === Dashboard ===
# Where the Dash app reads the dbt marts. Defaults match dbt's
# generate_schema_name macro for `--target prod`.
# DASHBOARD_MART_SCHEMA=MARTS
# DASHBOARD_METADATA_SCHEMA=METADATA
# Startup safety guard: refuses to load if a mart returns more than this.
# DASHBOARD_MAX_ROWS=200000
# Set to 1 to enable Dash dev-tools / interactive traceback (off by default).
# DASH_DEBUG=

# === Airflow REST API (used by ingest_pipeline_metadata DAG) ===
# Tasks run inside Docker and must use the service name, not localhost.
# On AWS/EC2 deploy, change to http://<host-internal-ip>:8080.
# Note: airflow_rest_client.py refuses to authenticate against any non-local
# host with the default 'admin' password — set a real password in production.
AIRFLOW_API_BASE_URL=http://api-server:8080
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=admin
